# ============================================================
# 智能日报生成器 — 环境变量模板
# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，不会进版本库。
#
# 安全约束（design.md §6.2）：所有密钥只从环境变量读取，
# 严禁写进 config.yaml 或任何源码文件。
# ============================================================

# ---------- GitHub ----------
# Personal Access Token（需 repo 读权限）
GITHUB_TOKEN=

# ---------- 飞书开放平台 ----------
# 自建应用凭证（开放平台 → 凭证与基础信息）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 机器人自身的 open_id：采集群消息时用于过滤掉机器人自己发的日报，
# 避免上一日的推送被当作今日的讨论记录回采。
# 查询方式：GET /open-apis/bot/v3/info
FEISHU_BOT_OPEN_ID=

# ---------- SMTP ----------
# 邮箱授权码（不是登录密码）
SMTP_PASSWORD=
